# Copy to .env and supply your own server-side values. Never commit .env.
# Use a long random secret; Google OAuth and Supabase email/password are supported.
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Exact public origin, without a path or trailing slash. Match the browser URL.
APP_ORIGIN=http://127.0.0.1:4322
SUPABASE_URL=
# Supabase Auth key and server database key; neither needs a PUBLIC_ prefix.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy fallback names remain supported: SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY.

# Stripe test credentials only until the owner approves live activation.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_LIVE_ENABLED=false
# Explicit initial destinations. Extend only after checking current carrier service.
SHIPPING_ALLOWED_COUNTRIES=TH,AU,AT,BE,BT,BR,KH,CA,CN,HR,DK,EE,FI,FR,DE,GR,HK,HU,IN,ID,IT,JP,KR,LA,LU,MY,MV,NL,NZ,NO,PH,PL,PT,RO,RU,SG,SK,SI,ZA,ES,SE,CH,TW,TR,AE,GB,US,VN
# Separate catalog prices: en/zh-CN USD, ja JPY, th THB. No FX-priced cart.
# Thailand Post 2022 rates are preparation references; Checkout adds no shipping fee.

# Transactional mail: verified sender/domain and actual seller mailbox.
RESEND_API_KEY=
EMAIL_FROM=
SELLER_EMAIL=

# Deployed Apps Script /exec URL and matching BOOKING_REPORT_SECRET property.
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_SECRET=
# Authenticated POST scheduler; never expose this token to browser code.
CRON_SECRET=

# Google provider subjects, comma-separated. Email is not admin authority.
ADMIN_GOOGLE_SUBJECTS=
