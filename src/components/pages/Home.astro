---
import Layout from '../../layouts/Layout.astro';
import Hero from '../ui/Hero.svelte';
import { ui, defaultLang } from '../../i18n/ui';

interface Props {
  lang: keyof typeof ui;
}

const { lang } = Astro.props;

function t(key: keyof typeof ui[typeof defaultLang]) {
  return ui[lang]?.[key] || ui[defaultLang][key];
}

function getPath(path: string) {
  if (lang === defaultLang) return path;
  return `/${lang}${path === '/' ? '' : path}`;
}
---

<Layout title={t('nav.home')} lang={lang}>
  <Hero lang={lang} client:load />

  <!-- Philosophy Section: The Ikigai Concept -->
  <section class="home-story py-32 px-6 bg-transparent relative">
    <div class="max-w-5xl mx-auto flex flex-col md:flex-row gap-16 items-center pl-1">
      <div class="w-full md:w-1/2" data-aos="fade-up">
        <h2 class="font-serif text-3xl md:text-5xl font-light tracking-tight mb-8" set:html={t('home.philosophy.title')}>
        </h2>
        <div class="space-y-6 text-neutral-400 font-normal leading-relaxed">
          <p set:html={t('home.philosophy.p1')}></p>
          <p set:html={t('home.philosophy.p2')}></p>
        </div>
        <div class="mt-12">
           <a href={getPath('/about')} class="text-white border-b border-white/30 pb-1 hover:border-white transition-colors uppercase tracking-widest text-sm">{t('home.philosophy.link')}</a>
        </div>
      </div>
      <div class="w-full md:w-1/2 relative">
        <div class="aspect-[4/5] overflow-hidden rounded-md ikigai-glass p-2">
            <img 
              src="/images/about4.jpg"
              alt="Artisan crafting instrument" 
              class="w-full h-full object-contain"
            />
        </div>
      </div>
    </div>
  </section>

  <!-- Bento Grid Showcase -->
  <section class="home-collection py-24 px-6 bg-transparent">
    <div class="max-w-7xl mx-auto pl-1">
      <div class="mb-16 text-center" data-aos="fade-up">
        <span class="font-serif tracking-[0.2em] text-xs uppercase text-neutral-500 mb-4 block">{t('home.masterpieces.subtitle')}</span>
        <h2 class="font-serif text-4xl md:text-5xl font-light">{t('home.masterpieces.title')}</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 md:grid-rows-2 gap-4 md:gap-6 h-auto md:h-[800px]">
        
        <!-- Large Featured Item -->
        <a href={getPath('/product/shakuhachi')} class="group md:col-span-2 md:row-span-2 min-h-[520px] flex flex-col overflow-hidden rounded-md ikigai-glass">
          <div class="flex min-h-0 flex-1 items-center justify-center bg-neutral-900 p-4">
            <img
              src="/images/ShakuhachiPoster1.jpg"
              alt="Shakuhachi S-1/D product and feature poster"
              class="w-full h-full object-contain"
            />
          </div>
          <div class="flex items-center justify-between gap-4 p-6">
            <div>
              <h3 class="font-serif text-2xl text-white">{t('home.shakuhachi.title')}</h3>
              <p class="text-sm text-neutral-400 mt-1">{t('home.shakuhachi.desc')}</p>
            </div>
            <span class="shrink-0 text-xs uppercase text-[#c2aa6a]">{t('home.viewdetail')}</span>
          </div>
        </a>

        <!-- Smaller Item 1 -->
        <a href={getPath('/product/siliconepads')} class="group min-h-[360px] flex flex-col overflow-hidden rounded-md ikigai-glass">
          <div class="flex min-h-0 flex-1 items-center justify-center bg-neutral-900 p-4">
            <img src="/images/SiliconePad1.jpg" alt="Silicone instrument pads" class="w-full h-full object-contain" />
          </div>
          <div class="p-5">
            <h3 class="font-serif text-xl text-white">{t('home.pads.title')}</h3>
            <p class="text-neutral-400 text-sm font-light mt-1">{t('home.pads.desc')}</p>
          </div>
        </a>

        <!-- Smaller Item 2 -->
        <a href={getPath('/repair-services')} class="group min-h-[360px] flex flex-col overflow-hidden rounded-md ikigai-glass">
          <div class="flex min-h-0 flex-1 items-center justify-center bg-neutral-900 p-4">
            <img src="/images/repair1.jpg" alt="Workshop instrument repair" class="w-full h-full object-contain" />
          </div>
          <div class="p-5">
            <h3 class="font-serif text-xl text-white">{t('home.repair.title')}</h3>
            <p class="text-neutral-400 text-sm font-light mt-1">{t('home.repair.desc')}</p>
          </div>
        </a>

      </div>
      
      <div class="mt-16 text-center" data-aos="fade-up">
        <a href={getPath('/product')} class="inline-block border-b border-neutral-600 pb-1 text-neutral-300 hover:text-white hover:border-white transition-colors uppercase text-sm">
          {t('home.viewall')}
        </a>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="home-final-banner py-32 px-6 relative overflow-hidden bg-transparent flex items-center justify-center">
    <div class="relative z-10 text-center max-w-2xl mx-auto pl-1" data-aos="zoom-in">
      <h2 class="font-serif text-3xl md:text-5xl font-light mb-8">{t('home.cta.title')}</h2>
      <a href={getPath('/product')} class="btn btn-primary">
        {t('home.cta.button')}
      </a>
    </div>
  </section>
</Layout>
