---
import Layout from '../../layouts/Layout.astro';
import Hero from '../ui/Hero.svelte';
import { ui, defaultLang } from '../../i18n/ui';

interface Props {
  lang: keyof typeof ui;
}

const { lang } = Astro.props;

function t(key: keyof typeof ui[typeof defaultLang]) {
  return ui[lang]?.[key] || ui[defaultLang][key];
}

function getPath(path: string) {
  if (lang === defaultLang) return path;
  return `/${lang}${path === '/' ? '' : path}`;
}
---

<Layout title={t('nav.home')} lang={lang}>
  <Hero lang={lang} client:load />

  <!-- Philosophy Section: The Ikigai Concept -->
  <section class="py-32 px-6 bg-transparent relative">
    <div class="max-w-5xl mx-auto flex flex-col md:flex-row gap-16 items-center pl-1">
      <div class="w-full md:w-1/2" data-aos="fade-up">
        <h2 class="font-serif text-3xl md:text-5xl font-light tracking-tight mb-8" set:html={t('home.philosophy.title')}>
        </h2>
        <div class="space-y-6 text-neutral-400 font-light leading-relaxed">
          <p set:html={t('home.philosophy.p1')}></p>
          <p set:html={t('home.philosophy.p2')}></p>
        </div>
        <div class="mt-12">
           <a href={getPath('/about')} class="text-white border-b border-white/30 pb-1 hover:border-white transition-colors uppercase tracking-widest text-sm">{t('home.philosophy.link')}</a>
        </div>
      </div>
      <div class="w-full md:w-1/2 relative grid grid-cols-2 gap-4 items-end">
        <div class="aspect-[4/5] overflow-hidden rounded-2xl ikigai-glass p-2">
            <img 
              src="/images/shakuhachi1.jfif" 
              alt="Artisan crafting instrument" 
              class="w-full h-full object-cover rounded-xl transition-all duration-700 hover:scale-105"
            />
        </div>
        <div class="space-y-4">
          <div class="aspect-square overflow-hidden rounded-2xl ikigai-glass p-2">
            <img
              src="/images/about6.jpg"
              alt="Design Music workshop"
              class="w-full h-full object-cover rounded-xl transition-all duration-700 hover:scale-105"
            />
          </div>
          <div class="aspect-square overflow-hidden rounded-2xl ikigai-glass p-2">
            <img
              src="/images/Drillmachine.JPG"
              alt="Workshop drill machine"
              class="w-full h-full object-cover rounded-xl transition-all duration-700 hover:scale-105"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Bento Grid Showcase -->
  <section class="py-24 px-6 bg-transparent">
    <div class="max-w-7xl mx-auto pl-1">
      <div class="mb-16 text-center" data-aos="fade-up">
        <span class="font-serif tracking-[0.2em] text-xs uppercase text-neutral-500 mb-4 block">{t('home.masterpieces.subtitle')}</span>
        <h2 class="font-serif text-4xl md:text-5xl font-light">{t('home.masterpieces.title')}</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 md:grid-rows-2 gap-4 md:gap-6 h-auto md:h-[800px]">
        
        <!-- Large Featured Item -->
        <a href={getPath('/product/shakuhachi')} class="group relative md:col-span-2 md:row-span-2 overflow-hidden rounded-3xl ikigai-glass">
          <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent z-10"></div>
          <img 
            src="/images/ShakuhachiPoster1.jpg" 
            alt="3D Printed Shakuhachi" 
            class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700"
          />
          <div class="absolute bottom-0 left-0 p-8 z-20 w-full">
            <h3 class="font-serif text-3xl mb-2 text-white group-hover:text-glow transition-all">{t('home.shakuhachi.title')}</h3>
            <p class="text-neutral-300 font-light mb-4 opacity-0 transform translate-y-4 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-500">
              {t('home.shakuhachi.desc')}
            </p>
            <span class="inline-block border border-white/20 px-4 py-1 rounded-full text-sm hover:bg-white hover:text-black transition-colors">{t('home.viewdetail')}</span>
          </div>
        </a>

        <!-- Smaller Item 1 -->
        <a href={getPath('/product/siliconepads')} class="group relative overflow-hidden rounded-3xl ikigai-glass">
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent z-10"></div>
          <img 
            src="/images/SiliconePad1.jpg" 
            alt="Silicone Pads" 
            class="w-full h-full object-cover transform group-hover:scale-110 transition-all duration-700"
          />
          <div class="absolute bottom-0 left-0 p-6 z-20">
            <h3 class="font-serif text-xl mb-1 text-white">{t('home.pads.title')}</h3>
            <p class="text-neutral-400 text-sm font-light">{t('home.pads.desc')}</p>
          </div>
        </a>

        <!-- Smaller Item 2 -->
        <a href={getPath('/repair-services')} class="group relative overflow-hidden rounded-3xl ikigai-glass">
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent z-10"></div>
          <img 
            src="/images/repair1.jpg" 
            alt="Repair Services" 
            class="w-full h-full object-cover transform group-hover:scale-110 transition-all duration-700"
          />
          <div class="absolute bottom-0 left-0 p-6 z-20">
            <h3 class="font-serif text-xl mb-1 text-white">{t('home.repair.title')}</h3>
            <p class="text-neutral-400 text-sm font-light">{t('home.repair.desc')}</p>
          </div>
        </a>

      </div>
      
      <div class="mt-16 text-center" data-aos="fade-up">
        <a href={getPath('/product')} class="inline-block border-b border-neutral-600 pb-1 text-neutral-400 hover:text-white hover:border-white transition-all uppercase tracking-widest text-sm">
          {t('home.viewall')}
        </a>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-32 px-6 relative overflow-hidden bg-transparent flex items-center justify-center">
    <div class="absolute inset-0 z-0 aurora-bg opacity-30 pointer-events-none"></div>
    <div class="relative z-10 text-center max-w-2xl mx-auto pl-1" data-aos="zoom-in">
      <h2 class="font-serif text-3xl md:text-5xl font-light mb-8">{t('home.cta.title')}</h2>
      <a href={getPath('/product')} class="px-10 py-4 bg-white text-black rounded-full font-medium tracking-wide transition-transform hover:scale-105 inline-block shadow-[0_0_40px_-10px_rgba(255,255,255,0.3)]">
        {t('home.cta.button')}
      </a>
    </div>
  </section>
</Layout>
