---
import '../styles/global.css';

import Navbar from '../components/Navbar.svelte';
import Footer from '../components/Footer.svelte';
import { getOptionalSession } from '../lib/server/customer';

interface Props {
  title: string;
  lang?: 'en' | 'ja' | 'zh-CN' | 'th';
  currentPath?: string;
}

const { pathname } = Astro.url;
const segments = pathname.split('/').filter(Boolean);
const detected = ['ja', 'zh-CN', 'th'].includes(segments[0]) ? segments[0] : 'en';
const { title, lang = detected as Props['lang'], currentPath = pathname + Astro.url.search } = Astro.props;
const session = await getOptionalSession(Astro.request);
const navbarSession = session ? { user: { name: session.user?.name ?? null, image: session.user?.image ?? null } } : null;
---

<!doctype html>
<html lang={lang} data-theme="black">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Design Music - Innovative Instruments & Excellent Repair. Bangkok, Thailand." />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Design Music</title>
  </head>
  <body class="min-h-screen flex flex-col text-white antialiased selection:bg-white/20">
    <Navbar lang={lang} currentPath={currentPath} session={navbarSession} client:load />
    <main class="flex-grow relative z-10 pt-20"><slot /></main>
    <Footer lang={lang} />
  </body>
</html>

