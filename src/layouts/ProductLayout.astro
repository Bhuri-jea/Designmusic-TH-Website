---
import Layout from './Layout.astro';
import ProductGallery from '../components/product/ProductGallery.svelte';

interface Props {
  /** Browser tab title */
  title: string;
  /** h1 heading shown on the page */
  pageTitle: string;
  /** Optional badge label (e.g. "Best Seller") */
  badge?: string;
  /** Main hero image */
  heroImage: string;
  /** Clickable thumbnail images */
  galleryImages?: string[];
  /** Back-button destination */
  backHref?: string;
  /** Back-button label */
  backLabel?: string;
  lang?: 'en' | 'ja' | 'zh-CN' | 'th';
  currentPath?: string;
}

const {
  title,
  pageTitle,
  badge,
  heroImage,
  galleryImages = [],
  backHref = '/product',
  backLabel = 'Back to Products',
  lang = 'en',
  currentPath,
} = Astro.props;
---

<Layout title={title} lang={lang} currentPath={currentPath} surface="product">
  <div class="product-detail-shell">
    <div class="product-detail-inner">
      <a href={backHref} class="product-back">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18l-6-6 6-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
        {backLabel}
      </a>
      <div class="product-stage">
        <div class="product-gallery-column">
          <ProductGallery client:load heroImage={heroImage} galleryImages={galleryImages} alt={pageTitle} />
        </div>
        <div class="product-configuration-column">
          {Astro.slots.has('configuration')?<div class="product-purchase"><slot name="configuration" /></div>:<>
          {badge && <div class="product-badge">{badge}</div>}
          <h1>{pageTitle}</h1>
          {Astro.slots.has('default') && <div class="product-description"><slot /></div>}
          <div class="product-purchase"><slot name="purchase" /></div>
          </>}
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .product-detail-shell{--product-ink:#2b252a;--product-muted:#4a4347;--product-line:#b9b0a4;--product-surface:#fcfaf5;--product-action:#30242d;--product-control:#92877f;--product-focus:#78551f;background:#f3efe6;color:var(--product-ink);min-height:75svh}
  .product-detail-inner{max-width:1440px;min-width:0;margin-inline:auto;padding:28px clamp(20px,5vw,72px) 72px}
  .product-back{display:inline-flex;align-items:center;gap:8px;min-height:44px;margin-bottom:22px;color:var(--product-muted);font-size:.85rem;font-weight:500;text-decoration:none}
  .product-back svg{width:18px;height:18px}.product-back:hover{text-decoration:underline;text-underline-offset:5px}
  .product-stage{display:grid;grid-template-columns:minmax(0,1.06fr) minmax(0,1fr);align-items:start;gap:clamp(28px,5vw,72px)}
  .product-gallery-column{min-width:0;position:sticky;top:112px}
  .product-configuration-column{min-width:0;max-width:100%;padding-block:8px 0;overflow-wrap:anywhere}
  .product-badge{font-size:.88rem;font-weight:600;line-height:1.4;border:1px solid #b39a68;border-radius:999px;padding:5px 13px;margin-bottom:18px;width:fit-content;color:#57401f;background:#eee0c5}
  h1{font-family:'Bodoni MT',Didot,'Times New Roman',serif;font-size:clamp(2.3rem,4vw,4rem);line-height:1.08;letter-spacing:-.035em;font-weight:400;text-wrap:balance;overflow-wrap:anywhere}
  .product-purchase{margin-top:22px}
  .product-description{margin-top:20px;max-width:100%;overflow-wrap:anywhere}
  .product-description :global(p),.product-description :global(li){font-size:.98rem;line-height:1.7;max-width:76ch}
  .product-description :global(h2){font-size:clamp(1.7rem,2.8vw,2.6rem);line-height:1.22}
  .product-description :global(h3),.product-description :global(h4){line-height:1.35}
  .product-detail-shell :global([class~="text-white"]){color:var(--product-ink)!important;text-shadow:none!important}
  .product-detail-shell :global([class*="text-neutral-"]){color:var(--product-muted)!important}
  .product-detail-shell :global([class*="border-white/"]){border-color:var(--product-line)!important}
  .product-detail-shell :global([class*="bg-white/"]){background:#fcfaf5!important;backdrop-filter:none!important}
  .product-detail-shell :global([class*="bg-neutral-900"]){background:#fcfaf5!important;box-shadow:none!important;border-radius:3px!important}
  .product-detail-shell :global([class~="stroke-white"]){stroke:var(--product-muted)}
  .product-purchase :global(.space-y-10){margin-top:0!important;row-gap:0}
  .product-purchase :global(.space-y-10> :not(:last-child)){margin-block-end:20px!important}
  .product-purchase :global(.space-y-6> :not(:last-child)){margin-block-end:10px!important}
  .product-purchase :global(h3){font-family:inherit;font-weight:600;font-size:.88rem;letter-spacing:0;text-transform:none;color:var(--product-ink)}
  .product-purchase :global(button[aria-pressed]){padding:15px 14px;min-height:58px;gap:9px;border:1px solid #92877f!important;border-radius:3px;box-shadow:none!important;transition:background 140ms ease,color 140ms ease}
  .product-purchase :global(button[aria-pressed="false"]){background:#fcfaf5!important;color:var(--product-ink)!important}
  .product-purchase :global(button[aria-pressed="true"]){background:#30242d!important;border-color:#30242d!important;color:#f5f1e8!important}
  .product-purchase :global(button[aria-pressed] span){color:inherit!important;letter-spacing:0;text-transform:none}
  .product-purchase :global(button[aria-pressed="false"]:hover){background:#ece5da!important}
  .product-purchase :global(.grid){gap:9px}
  .product-purchase :global(.p-8){padding:20px 0!important;border-inline:0!important;border-bottom:0!important;align-items:stretch!important;gap:18px;flex-direction:column!important;background:transparent!important}
  .product-purchase :global(.btn-primary){min-height:52px;width:100%;padding:14px 20px;background:#30242d!important;border:1px solid #30242d!important;border-radius:3px;color:#f5f1e8!important;font-weight:500;box-shadow:none!important}
  .product-purchase :global(.btn-primary:hover){background:#44333f!important}
  .product-purchase :global(select),.product-purchase :global(input),.product-purchase :global(textarea),.product-purchase :global(option){background:#fcfaf5;color:var(--product-ink);color-scheme:light;border-color:#92877f}
  .product-detail-shell :global(:focus-visible){outline:2px solid #78551f!important;outline-offset:4px}
  .product-description :global(a){text-decoration:underline;text-underline-offset:4px}
  .product-purchase :global(.reservation-notice){display:grid!important;grid-template-columns:24px minmax(0,1fr);align-items:start!important;gap:16px;padding:20px!important}
  .product-purchase :global(.reservation-notice>div){min-width:0}
  .product-purchase :global(.reservation-notice>div:last-child){grid-column:1/-1;width:100%!important;margin:0}
  .product-purchase :global(.reservation-notice a){display:block;box-sizing:border-box;max-width:100%;padding:13px 15px;white-space:normal;overflow-wrap:anywhere;line-height:1.5;background:#30242d;color:#f5f1e8!important;border-radius:8px}
  @media(max-width:1023px){.product-stage{grid-template-columns:minmax(0,1fr);gap:26px}.product-gallery-column{position:static}.product-configuration-column{padding-top:0}.product-description{margin-top:18px}.product-detail-inner{padding:24px clamp(16px,4vw,32px) 48px}.product-back{margin-bottom:18px}}
  @media(min-width:1024px){.product-back,.product-badge,.product-purchase :global(h3){font-size:.95rem}.product-description :global(p),.product-description :global(li){font-size:1.05rem}}
  @media(prefers-reduced-motion:reduce){.product-purchase :global(button){transition:none!important}}
</style>
