---
import Layout from './Layout.astro';
import ProductGallery from '../components/product/ProductGallery.svelte';
import { ArrowLeft } from 'lucide-svelte';

interface Props {
  /** Browser tab title */
  title: string;
  /** h1 heading shown on the page */
  pageTitle: string;
  /** Optional badge label (e.g. "Best Seller") */
  badge?: string;
  /** Main hero image */
  heroImage: string;
  /** Clickable thumbnail images */
  galleryImages?: string[];
  /** Back-button destination */
  backHref?: string;
  /** Back-button label */
  backLabel?: string;
  lang?: 'en' | 'ja' | 'zh-CN' | 'th';
  currentPath?: string;
}

const {
  title,
  pageTitle,
  badge,
  heroImage,
  galleryImages = [],
  backHref = '/product',
  backLabel = 'Back to Products',
  lang = 'en',
  currentPath,
} = Astro.props;
---

<Layout title={title} lang={lang} currentPath={currentPath}>
  <div class="max-w-6xl mx-auto px-6 py-16 relative z-10 pl-1">
    <a
      href={backHref}
      class="inline-flex items-center gap-2 mb-8 text-neutral-400 hover:text-white transition-colors tracking-widest uppercase text-sm border-b border-transparent hover:border-white pb-1"
    >
      <ArrowLeft class="w-4 h-4" /> {backLabel}
    </a>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12">
      <!-- Left: interactive image gallery -->
      <div data-aos="fade-right">
        <ProductGallery
          client:load
          heroImage={heroImage}
          galleryImages={galleryImages}
          alt={pageTitle}
        />
      </div>

      <!-- Right: product info -->
      <div class="py-4 flex flex-col justify-center" data-aos="fade-left">
        {badge && (
          <div class="inline-block border border-white/20 px-3 py-1 rounded-full text-xs tracking-widest uppercase mb-6 w-fit text-neutral-300">
            {badge}
          </div>
        )}
        <h1 class="font-serif text-4xl md:text-5xl font-light tracking-tight mb-4 text-glow text-white">
          {pageTitle}
        </h1>

        <!-- Product description / feature content -->
        <slot />

        <!-- Purchase widget (AddToCart / reservation notice) -->
        <div class="mt-10 pt-10 border-t border-white/10">
          <slot name="purchase" />
        </div>
      </div>
    </div>
  </div>
</Layout>
