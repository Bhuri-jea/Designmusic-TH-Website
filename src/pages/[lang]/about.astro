---
import About from "../../components/pages/About.astro";
import { ui } from "../../i18n/ui";
import { isSupportedLocale } from '../../lib/server/locales';

const { lang } = Astro.params;
if (!isSupportedLocale(lang) || lang === 'en') return new Response(null, { status: 404 });
---

<About lang={lang as keyof typeof ui} />



