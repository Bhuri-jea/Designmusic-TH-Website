---
import Home from '../../components/pages/Home.astro';
import { ui } from '../../i18n/ui';

export function getStaticPaths() {
  return [
    { params: { lang: 'ja' } },
    { params: { lang: 'zh-CN' } },
    { params: { lang: 'th' } },
  ];
}

const { lang } = Astro.params;
---
<Home lang={lang as keyof typeof ui} />
