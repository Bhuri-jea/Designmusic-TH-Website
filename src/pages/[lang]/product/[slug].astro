---
import ProductLayout from '../../../layouts/ProductLayout.astro';
import { isSupportedLocale } from '../../../lib/server/locales';
import {publishedProduct} from '../../../lib/server/catalog-public';
import CatalogPurchase from '../../../components/product/CatalogPurchase.svelte';

const { lang, slug } = Astro.params;
export const prerender=false;
if (!isSupportedLocale(lang) || lang === 'en' || !slug) return new Response(null, { status: 404 });
const product=await publishedProduct(lang,slug);if(!product)return new Response(null,{status:404});

const ui = {
  en: { backLabel: 'Back to Products' },
  ja: { backLabel: '製品一覧に戻る' },
  'zh-CN': { backLabel: '返回产品' },
  th: { backLabel: 'กลับไปยังผลิตภัณฑ์' },
};
const backLabel = ui[lang]?.backLabel ?? ui.en.backLabel;
---

<ProductLayout
  title={product.name}
  pageTitle={product.name}
  badge={product.badge}
  heroImage={product.thumbnail}
  galleryImages={product.images.map(image=>image.url)}
  backHref={`/${lang}/product`}
  backLabel={backLabel}
  lang={lang}
>
  <CatalogPurchase slot="purchase" client:load {product} {lang}/>
  <div class="prose prose-invert max-w-none"><p>{product.description}</p></div>
</ProductLayout>



