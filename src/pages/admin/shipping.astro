---
import Layout from '../../layouts/Layout.astro';
import AdminShippingSettings from '../../components/account/AdminShippingSettings.svelte';
import { requireAdmin } from '../../lib/server/admin';
import { HttpError } from '../../lib/server/http';
export const prerender = false;
Astro.response.headers.set('Cache-Control', 'private, no-store');
let allowed = false, message = 'Seller tools are unavailable.';
try { await requireAdmin(Astro.request); allowed = true; }
catch (error) { if (error instanceof HttpError) { Astro.response.status = error.status; message = error.status === 401 ? 'Sign in with an approved Google account to access seller tools.' : error.status === 403 ? 'This account does not have seller access.' : 'Seller tools are unavailable. Please try again later.'; } }
---
<Layout title="Shipping settings · Seller preparation">{allowed ? <AdminShippingSettings client:load lang="en"/> : <div class="max-w-3xl mx-auto px-6 py-32"><h1 class="font-serif text-4xl mb-6">Seller preparation</h1><p>{message}</p><a class="btn mt-6" href="/login">Sign in</a></div>}</Layout>
