---
import '../../styles/repair-editorial.css';
import Layout from '../../layouts/Layout.astro';
import BookingForm from '../../components/ui/BookingForm.svelte';
---

<Layout title="ご予約" surface="booking">
  <div class="booking-editorial">
    <section class="booking-story">
      <img src="/images/repair1.jpg" alt="" class="booking-story-image" fetchpriority="high" />
    <div class="booking-story-content">
      <span class="font-serif tracking-[0.2em] text-xs uppercase text-neutral-500 mb-4 block">修理のご予約</span>
      <h1 class="font-serif text-5xl md:text-6xl font-light mb-6 tracking-tight">予約 <span class="italic text-neutral-400">する</span></h1>
      <p class="text-lg font-light text-neutral-400 max-w-2xl mx-auto">
        楽器のドロップオフまたは当社の専門家による査定を受けるための便利な1時間のタイムスロットを選択してください。
      </p>
    </div>
    </section>
    <div class="booking-workspace">
    <a href="/ja/repair-services" class="inline-flex items-center gap-2 mb-12 text-neutral-400 hover:text-white transition-colors tracking-widest uppercase text-sm border-b border-transparent hover:border-white pb-1">
      <svg viewBox="0 0 24 24" aria-hidden="true" class="w-4 h-4"><path d="M15 18l-6-6 6-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
      サービスに戻る
    </a>
    <div class="booking-live-form">
      <BookingForm lang="ja" client:load />
    </div>
    </div>
  </div>
</Layout>
