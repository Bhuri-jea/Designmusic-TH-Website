---
import ProductLayout from '../../../layouts/ProductLayout.astro';
import { CheckCircle2 } from 'lucide-svelte';
import { products } from '../../../lib/products';

const p = products.find(x => x.slug === 'siliconepads')!;
---

<ProductLayout
  title="シリコンタンポ"
  pageTitle="シリコンタンポ"
  badge={p.badge}
  heroImage={p.heroImage}
  galleryImages={p.galleryImages}
  backHref="/ja/product"
  backLabel="製品一覧に戻る"
  lang="ja"
>
  <p class="text-xl font-light text-neutral-400 mb-6">サックス &amp; クラリネットのオクターブキー用</p>

  <div class="prose max-w-none text-neutral-300 font-light leading-relaxed">
    <p class="text-lg">
      先端が尖った円錐形状の革新的なシリコンタンポは、オクターブの高音域における乱流の雑音を抑え、演奏時の奏感を向上させます。
    </p>

    <div class="bg-white/5 backdrop-blur-sm rounded-3xl p-8 my-8 space-y-6 border border-white/10">
      <h3 class="font-medium tracking-widest uppercase text-sm flex items-center gap-3 text-white m-0">
        <CheckCircle2 class="w-5 h-5 text-neutral-400" /> 製品の効果
      </h3>
      <ul class="list-none space-y-4 m-0 p-0 text-neutral-400">
        <li class="flex items-start gap-3"><span class="text-white font-bold opacity-50">•</span>空気の滞留を減らす</li>
        <li class="flex items-start gap-3"><span class="text-white font-bold opacity-50">•</span>気流を側面へと誘導する</li>
        <li class="flex items-start gap-3"><span class="text-white font-bold opacity-50">•</span>長寿命で安定した性能を維持する</li>
      </ul>
    </div>
  </div>

  <!-- Reservation notice in the purchase slot -->
  <div slot="purchase" class="p-6 bg-neutral-900 border border-white/10 shadow-2xl rounded-3xl flex flex-col sm:flex-row gap-6 items-start sm:items-center">
    <svg xmlns="http://www.w3.org/2000/svg" class="stroke-white shrink-0 h-6 w-6 opacity-70" fill="none" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
    </svg>
    <div class="flex-grow">
      <h3 class="font-medium tracking-widest uppercase text-white text-sm">予約制です</h3>
      <div class="text-sm font-light text-neutral-400 mt-2">詳細はお問い合わせください。</div>
    </div>
    <div class="flex-none w-full sm:w-auto mt-4 sm:mt-0">
      <a href="/ja/repair-services" class="inline-block px-8 py-3 bg-white text-black font-medium tracking-widest uppercase rounded-full hover:bg-neutral-200 transition-colors w-full text-center text-sm shadow-[0_0_20px_-5px_rgba(255,255,255,0.3)]">予約する</a>
    </div>
  </div>
</ProductLayout>
