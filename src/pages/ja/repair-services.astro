---
import '../../styles/repair-editorial.css';
import Layout from '../../layouts/Layout.astro';
import RepairAvailability from '../../components/ui/RepairAvailability.svelte';
---

<Layout title="修理サービス" surface="repair">
  <div class="repair-editorial">
    <section class="repair-hero">
      <img src="/images/soprano%20sax.jpg" alt="" class="repair-hero-image" fetchpriority="high" />
    <div class="repair-hero-content">
      <h1 class="font-serif text-5xl md:text-6xl font-light mb-6 tracking-tight">修理 <span class="italic text-neutral-400">&amp; サービス</span></h1>
      <p class="text-xl font-light text-neutral-400 max-w-3xl mx-auto leading-relaxed">
        台湾での集中的な修理研修と10年以上の実務経験を積み重ねた専門知識を活かし、各楽器の音色、レスポンス、個性を引き出すための修理に尽力しています。
      </p>
      <a href="/ja/booking" class="repair-hero-cta">予約する</a>
    </div>
    </section>
    <div class="repair-content">
    <div class="repair-calendar" id="repair-availability"><RepairAvailability lang="ja" client:load /></div>

    <!-- Alert / Notice -->
    <div class="alert shadow-lg max-w-2xl mx-auto mb-16">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-white shrink-0 w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
      <div>
        <h3 class="font-medium tracking-widest uppercase text-sm text-white mb-2">ご注意ください：</h3>
        <ul class="text-sm list-disc list-inside text-neutral-400 space-y-1 font-light">
          <li>これらは参考用の概算価格です。</li>
          <li>修理費用は楽器の状態により異なります。</li>
          <li>空いている日時をサイトからご予約ください。サービス選びに迷う場合はお問い合わせください。</li>
        </ul>
      </div>
    </div>



    <div class="repair-workshop"><img src="/images/repair1.jpg" alt="修理作業台で楽器を修理する技術者" class="repair-workshop-image" loading="lazy" /></div>
    <!-- Saxophone Section -->
    <div class="mb-32">
      <div class="mb-12 text-center">
        <h2 class="font-serif text-4xl font-light mb-4">サックス</h2>
        <p class="text-lg font-light text-neutral-400">高品質なシェラック塗料と本物のピゾーニタンポを使用しています。</p>
        <p class="text-lg font-light text-neutral-400">ソプラノ、アルト、テナー、バリトンすべてに対応します。</p>
        <p class="text-sm text-neutral-500 mt-4 italic">（以下の参考価格はアルトサックスの場合です。）</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Basic -->
        <div class="card hover:border-white/40 transition-colors">
          <div class="card-body">
            <h3 class="card-title text-2xl">基本</h3>
            <div class="text-white font-medium text-3xl my-4">1,000 THB 〜</div>
            <ul class="space-y-3 mt-4 flex-grow font-light text-neutral-300">
              <li class="flex items-center gap-3"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-neutral-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg> タンポ調整</li>
              <li class="flex items-center gap-3"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-neutral-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg> コルク交換</li>
            </ul>
            <div class="card-actions justify-end mt-8">
              <a href="/ja/booking" class="btn btn-secondary w-full tracking-widest uppercase">予約する</a>
            </div>
          </div>
        </div>

        <!-- Standard -->
        <div class="card bg-white text-black">
          <div class="card-body relative">
            <div class="self-end bg-black text-white px-3 py-1 rounded-full text-xs font-medium tracking-widest uppercase border border-white/20">人気</div>
            <h3 class="card-title text-2xl text-black">標準</h3>
            <div class="font-medium text-3xl my-4">3,500 THB 〜</div>
            <ul class="space-y-3 mt-4 flex-grow font-light">
              <li class="flex items-center gap-3"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-neutral-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg> タンポ調整</li>
              <li class="flex items-center gap-3"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-neutral-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg> コルク交換</li>
              <li class="flex items-center gap-3"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-neutral-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg> パッド交換</li>
              <li class="flex items-center gap-3"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-neutral-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg> ボディクリーニング</li>
              <li class="flex items-center gap-3"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-neutral-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg> バネ交換</li>
            </ul>
            <div class="card-actions justify-end mt-8">
              <a href="/ja/booking" class="btn bg-black text-white hover:bg-neutral-800 w-full tracking-widest uppercase">予約する</a>
            </div>
          </div>
        </div>

        <!-- Overhaul -->
        <div class="card hover:border-white/40 transition-colors">
          <div class="card-body">
            <h3 class="card-title text-2xl">オーバーホール</h3>
            <div class="text-white font-medium text-3xl my-4">5,000 THB 〜</div>
            <ul class="space-y-3 mt-4 flex-grow font-light text-neutral-300">
              <li class="flex items-center gap-3"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-neutral-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg> タンポ調整</li>
              <li class="flex items-center gap-3"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-neutral-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg> コルク交換</li>
              <li class="flex items-center gap-3"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-neutral-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg> タンポ交換</li>
              <li class="flex items-center gap-3"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-neutral-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg> ボディクリーニング</li>
              <li class="flex items-center gap-3"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-neutral-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg> バネ交換</li>
              <li class="flex items-center gap-3"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-neutral-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg> フェルト交換</li>
              <li class="flex items-center gap-3"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-neutral-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg> へこみ修正</li>
            </ul>
            <div class="card-actions justify-end mt-8">
              <a href="/ja/booking" class="btn btn-secondary w-full tracking-widest uppercase">予約する</a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Bassoon Section -->
    <div>
      <div class="mb-12 text-center">
        <h2 class="font-serif text-4xl font-light mb-4">ファゴット</h2>
        <p class="text-lg font-light text-neutral-400">高品質なシェラック塗料と本物のピゾーニタンポを使用しています。</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
        <!-- Standard -->
        <div class="card hover:border-white/40 transition-colors">
          <div class="card-body">
            <h3 class="card-title text-2xl">標準</h3>
            <div class="text-white font-medium text-3xl my-4">3,500 THB 〜</div>
            <ul class="space-y-3 mt-4 flex-grow font-light text-neutral-300">
              <li class="flex items-center gap-3"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-neutral-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg> タンポ調整</li>
              <li class="flex items-center gap-3"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-neutral-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg> コルク交換</li>
              <li class="flex items-center gap-3"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-neutral-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg> タンポ交換</li>
              <li class="flex items-center gap-3"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-neutral-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg> ボディクリーニング</li>
              <li class="flex items-center gap-3"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-neutral-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg> バネ交換</li>
            </ul>
            <div class="card-actions justify-end mt-8">
              <a href="/ja/booking" class="btn btn-secondary w-full tracking-widest uppercase">予約する</a>
            </div>
          </div>
        </div>

        <!-- Overhaul -->
        <div class="card hover:border-white/40 transition-colors">
          <div class="card-body">
            <h3 class="card-title text-2xl">オーバーホール</h3>
            <div class="text-white font-medium text-3xl my-4">5,000 THB 〜</div>
            <ul class="space-y-3 mt-4 flex-grow font-light text-neutral-300">
              <li class="flex items-center gap-3"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-neutral-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg> タンポ調整</li>
              <li class="flex items-center gap-3"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-neutral-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg> コルク交換</li>
              <li class="flex items-center gap-3"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-neutral-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg> タンポ交換</li>
              <li class="flex items-center gap-3"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-neutral-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg> ボディクリーニング</li>
              <li class="flex items-center gap-3"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-neutral-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg> バネ交換</li>
              <li class="flex items-center gap-3"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-neutral-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg> フェルト交換</li>
              <li class="flex items-center gap-3"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-neutral-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg> へこみ修正</li>
            </ul>
            <div class="card-actions justify-end mt-8">
              <a href="/ja/booking" class="btn btn-secondary w-full tracking-widest uppercase">予約する</a>
            </div>
