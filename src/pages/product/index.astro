---
import Layout from '../../layouts/Layout.astro';
import { products } from '../../lib/products';

// Show all top-level products on the index (no category filter)
const allProducts = products;
---

<Layout title="Products">
  <div class="max-w-7xl mx-auto px-6 py-16 relative z-10">
    <div class="text-center mb-12" data-aos="fade-up">
      <span class="font-serif tracking-[0.2em] text-xs uppercase text-neutral-500 mb-4 block">Our Collection</span>
      <h1 class="font-serif text-5xl md:text-6xl font-light mb-6 tracking-tight">
        Master<span class="italic text-neutral-400">pieces</span>
      </h1>
      <p class="text-xl font-light text-neutral-400 max-w-2xl mx-auto">
        Crafted with uncompromising dedication to quality and the pursuit of perfect resonance.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {allProducts.map((p, i) => (
        <a
          href={`/product/${p.slug}`}
          class="card group transition-colors hover:border-white/30"
          data-aos="fade-up"
          data-aos-delay={(i + 1) * 100}
        >
          <div class="flex h-72 items-center justify-center bg-neutral-900 p-4">
            <img
              src={p.thumbnail}
              alt={p.name}
              class="h-full w-full object-contain"
              loading={i === 0 ? 'eager' : 'lazy'}
            />
          </div>
          <div class="card-body">
            <h2 class="font-serif text-2xl text-white mb-2">{p.name}</h2>
            {p.badge && (
              <span class="badge self-start mb-2">{p.badge}</span>
            )}
            <p class="text-neutral-400 font-light text-sm mb-6">
              {p.shortDesc}
            </p>
            <span class="mt-auto text-xs font-medium tracking-widest uppercase text-[#c2aa6a]">View Details</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</Layout>
