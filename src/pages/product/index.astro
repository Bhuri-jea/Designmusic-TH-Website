---
import Layout from '../../layouts/Layout.astro';
import { products } from '../../lib/products';

// Show all top-level products on the index (no category filter)
const allProducts = products;
---

<Layout title="Products">
  <div class="max-w-7xl mx-auto px-6 py-16 relative z-10">
    <div class="text-center mb-12" data-aos="fade-up">
      <span class="font-serif tracking-[0.2em] text-xs uppercase text-neutral-500 mb-4 block">Our Collection</span>
      <h1 class="font-serif text-5xl md:text-6xl font-light mb-6 tracking-tight">
        Master<span class="italic text-neutral-400">pieces</span>
      </h1>
      <p class="text-xl font-light text-neutral-400 max-w-2xl mx-auto">
        Crafted with uncompromising dedication to quality and the pursuit of perfect resonance.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {allProducts.map((p, i) => (
        <a
          href={`/product/${p.slug}`}
          class="group relative overflow-hidden rounded-3xl ikigai-glass"
          data-aos="fade-up"
          data-aos-delay={(i + 1) * 100}
        >
          <div class="h-80 overflow-hidden relative">
            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent z-10"></div>
            <img
              src={p.thumbnail}
              alt={p.name}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-1000"
              loading={i === 0 ? 'eager' : 'lazy'}
            />
          </div>
          <div class="absolute bottom-0 left-0 p-8 z-20 w-full">
            <h2 class="font-serif text-2xl text-white mb-2 group-hover:text-glow transition-all">{p.name}</h2>
            {p.badge && (
              <span class="inline-block mb-2 border border-white/40 px-3 py-0.5 rounded-full text-xs tracking-widest uppercase text-neutral-100">{p.badge}</span>
            )}
            <p class="text-neutral-200 font-light text-sm mb-6 opacity-75 translate-y-4 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-500">
              {p.shortDesc}
            </p>
            <span class="inline-block border border-white/20 px-5 py-2 rounded-full text-xs font-medium tracking-widest uppercase text-white hover:bg-white hover:text-black transition-colors">View Details</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</Layout>
