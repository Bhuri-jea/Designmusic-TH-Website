---
import ProductLayout from '../../layouts/ProductLayout.astro';
import EndPlugProduct from '../../components/product/EndPlugProduct.svelte';
import { products } from '../../lib/products';

const p = products.find(x => x.slug === 'saxophone-end-plug')!;
---

<ProductLayout
  title="Saxophone End Plug"
  pageTitle="Saxophone End Plug"
  badge={p.badge}
  heroImage={p.heroImage}
  galleryImages={p.galleryImages}
>
  <div class="prose max-w-none mt-8 text-neutral-300 font-light leading-relaxed">
    <p class="text-lg">
      End plug is a necessary item to prevent damage to the delicate octave key mechanism
      and to protect the neck receiver while the instrument is in its case.
    </p>
    <h3 class="font-medium tracking-widest uppercase text-sm text-white mt-10 mb-6">Our Unique Collection</h3>
    <p class="mb-6">
      We believe even a functional tool should be memorable. We offer the most customizable
      saxophone end plugs on the market, designed to fit your personality perfectly.
    </p>
    <ul class="list-none space-y-4 m-0 p-0 text-neutral-400">
      <li class="flex items-start gap-3"><span class="text-white font-bold opacity-50">•</span>We offer more than 35 options of plain, clear, pastel and metallic color</li>
      <li class="flex items-start gap-3"><span class="text-white font-bold opacity-50">•</span>2 colors, Marble‑like pattern</li>
      <li class="flex items-start gap-3"><span class="text-white font-bold opacity-50">•</span>Cute animal model</li>
      <li class="flex items-start gap-3"><span class="text-white font-bold opacity-50">•</span>Customizable name plate inside the end plug</li>
    </ul>
  </div>

  <EndPlugProduct slot="purchase" client:load />
</ProductLayout>
