---
import Layout from '../layouts/Layout.astro';
import { User, Mail, Phone, Calendar, ArrowRight, LogOut } from 'lucide-svelte';
import { getSession } from 'auth-astro/server';

const session = await getSession(Astro.request);
if (!session) {
  return Astro.redirect('/login');
}
---

<Layout title="My Profile">
  <div class="max-w-4xl mx-auto px-6 py-24 relative z-10 pl-1">
    <div class="flex justify-between items-end mb-12" data-aos="fade-up">
      <div>
        <span class="font-serif tracking-[0.2em] text-xs uppercase text-neutral-500 mb-2 block">Account</span>
        <div class="flex items-center gap-4">
          {session?.user?.image && (
            <img src={session.user.image} alt="Avatar" class="w-16 h-16 rounded-full border border-white/20" />
          )}
          <h1 class="font-serif text-5xl font-light tracking-tight">{session?.user?.name || 'My Profile'}</h1>
        </div>
      </div>
      <button id="signout-btn" class="btn btn-ghost text-red-400 hover:text-red-300 gap-2"><LogOut class="w-4 h-4" /> Sign Out</button>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
      <!-- Profile Data -->
      <div class="lg:col-span-2 space-y-8" data-aos="fade-up" data-aos-delay="100">
        <div class="bg-neutral-900/60 backdrop-blur-xl border border-white/10 rounded-3xl p-8">
          <h2 class="text-lg font-serif text-white mb-6 border-b border-white/10 pb-4">Personal Information</h2>
          
          <form class="space-y-6">
            <div class="space-y-2">
              <label for="name" class="text-xs font-medium tracking-widest uppercase text-neutral-400 flex items-center gap-2"><User class="w-4 h-4" /> Full Name</label>
              <input id="name" type="text" value={session?.user?.name} class="w-full bg-black/50 border border-white/20 rounded-xl p-4 text-white focus:outline-none focus:border-white transition-all" />
            </div>

            <div class="space-y-2">
              <label for="email" class="text-xs font-medium tracking-widest uppercase text-neutral-400 flex items-center gap-2"><Mail class="w-4 h-4" /> Email Address (Google)</label>
              <input id="email" type="email" value={session?.user?.email} disabled class="w-full bg-black/20 border border-white/10 rounded-xl p-4 text-neutral-500 cursor-not-allowed" />
            </div>

            <div class="space-y-2">
              <label for="phone" class="text-xs font-medium tracking-widest uppercase text-neutral-400 flex items-center gap-2"><Phone class="w-4 h-4" /> Phone Number</label>
              <input id="phone" type="tel" placeholder="+66 123 456 789" class="w-full bg-black/50 border border-white/20 rounded-xl p-4 text-white focus:outline-none focus:border-white transition-all" />
            </div>

            <div class="pt-4 flex justify-end">
              <button type="submit" class="btn btn-primary px-8">Save Changes</button>
            </div>
          </form>
        </div>
      </div>

      <!-- Upcoming Appointments -->
      <div data-aos="fade-up" data-aos-delay="200">
        <div class="bg-white/5 border border-white/10 rounded-3xl p-8 sticky top-32">
          <h2 class="text-lg font-serif text-white mb-6 flex items-center gap-2"><Calendar class="w-5 h-5 opacity-70" /> Appointments</h2>
          
          <div class="space-y-4">
            <div class="p-4 rounded-xl border border-white/10 bg-black/30">
              <div class="text-xs tracking-widest text-neutral-400 uppercase mb-2">Upcoming</div>
              <div class="font-medium text-white mb-1">Saxophone Standard Service</div>
              <div class="text-sm font-light text-neutral-400">Oct 12, 10:00 - 11:00</div>
            </div>

            <a href="/booking" class="block w-full py-4 text-center text-sm font-medium tracking-widest uppercase text-neutral-300 hover:text-white border border-white/20 rounded-xl hover:bg-white/5 transition-all">
              Book New Slot
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { signOut } from 'auth-astro/client';
  
  const btn = document.getElementById('signout-btn');
  if (btn) {
    btn.addEventListener('click', () => {
      signOut({ callbackUrl: '/' });
    });
  }
</script>
