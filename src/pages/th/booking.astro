---
import '../../styles/repair-editorial.css';
import Layout from '../../layouts/Layout.astro';
import BookingForm from '../../components/ui/BookingForm.svelte';
---

<Layout title="ทำการจองเวลา" surface="booking">
  <div class="booking-editorial">
    <section class="booking-story">
      <img src="/images/repair1.jpg" alt="" class="booking-story-image" fetchpriority="high" />
    <div class="booking-story-content">
      <span class="font-serif tracking-[0.2em] text-xs uppercase text-neutral-500 mb-4 block">นัดหมายซ่อมเครื่อง</span>
      <h1 class="font-serif text-5xl md:text-6xl font-light mb-6 tracking-tight">จองนัดเวลา</h1>
      <p class="text-lg font-light text-neutral-400 max-w-2xl mx-auto">
        เลือกช่วงเวลา ที่สะดวกเพื่อนำเครื่องดนตรีของคุณมาหรือให้ผู้เชี่ยวชาญของเราประเมิน
      </p>
    </div>
    </section>
    <div class="booking-workspace">
    <a href="/th/repair-services" class="inline-flex items-center gap-2 mb-12 text-neutral-400 hover:text-white transition-colors tracking-widest uppercase text-sm border-b border-transparent hover:border-white pb-1">
      <svg viewBox="0 0 24 24" aria-hidden="true" class="w-4 h-4"><path d="M15 18l-6-6 6-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
      กลับไปยังบริการ
    </a>
    <div class="booking-live-form">
      <BookingForm lang="th" client:load />
    </div>
    </div>
  </div>
</Layout>
