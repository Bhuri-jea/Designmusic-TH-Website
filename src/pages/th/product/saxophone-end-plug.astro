---
import ProductLayout from '../../../layouts/ProductLayout.astro';
import EndPlugProduct from '../../../components/product/EndPlugProduct.svelte';
import { products } from '../../../lib/products';

const p = products.find(x => x.slug === 'saxophone-end-plug')!;
---

<ProductLayout
  title="จุก Endplug แซกโซโฟน"
  pageTitle="จุก Endplug แซกโซโฟน"
  badge={p.badge}
  heroImage={p.heroImage}
  galleryImages={p.galleryImages}
  backHref="/th/product"
  backLabel="กลับไปยังผลิตภัณฑ์"
  lang="th"
>
  <div class="prose max-w-none mt-8 text-neutral-300 font-light leading-relaxed">
    <p class="text-lg">
      ปลั๊กปลายเป็นอุปกรณ์จำเป็นที่ช่วยปกป้องกลไกคีย์อ็อกเตฟและตัวรับคอของแซกโซโฟนเมื่อเก็บในกระเป๋า ช่วยลดความเสี่ยงของการสึกหรอและความเสียหายระหว่างการจัดเก็บ.
    </p>
    <h3 class="font-medium tracking-widest uppercase text-sm text-white mt-10 mb-6">คอลเลกชันที่เป็นเอกลักษณ์</h3>
    <p class="mb-6">
      เราสร้างสรรค์ทั้งฟังก์ชันและสไตล์ด้วยตัวเลือกกว่า 35 แบบ ทั้งสีเรียบ ลายหินอ่อน และลายสัตว์ เพื่อให้ปลั๊กปลายของคุณโดดเด่นและตอบโจทย์ความเป็นตัวเอง.
    </p>
    <ul class="list-none space-y-4 m-0 p-0 text-neutral-400">
      <li class="flex items-start gap-3"><span class="text-white font-bold opacity-50">•</span>มีให้เลือกกว่า 35 สี ทั้งโทนเรียบ โทนใส พาสเทล และเมทัลลิก</li>
      <li class="flex items-start gap-3"><span class="text-white font-bold opacity-50">•</span>รองรับการออกแบบ 2 สีและลายหินอ่อน</li>
      <li class="flex items-start gap-3"><span class="text-white font-bold opacity-50">•</span>มีลายสัตว์สุดน่ารักให้เลือก</li>
      <li class="flex items-start gap-3"><span class="text-white font-bold opacity-50">•</span>สามารถสั่งทำป้ายชื่อภายในปลั๊กได้</li>
    </ul>
  </div>

  <EndPlugProduct slot="purchase" client:load />
</ProductLayout>
