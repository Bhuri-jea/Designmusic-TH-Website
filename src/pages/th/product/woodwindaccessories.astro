---
import Layout from '../../../layouts/Layout.astro';
import { ArrowLeft, Sparkles, Shield, Zap } from 'lucide-svelte';
import { products } from '../../../lib/products';

// All products that belong to this category
const accessories = products.filter(p => p.category === 'woodwindaccessories');
const hero = products.find(p => p.slug === 'woodwindaccessories')!;
---

<Layout title="อุปกรณ์เครื่องเป่าลมไม้">
  <div class="max-w-7xl mx-auto px-6 py-16 relative z-10">
    <a href="/th/product" class="inline-flex items-center gap-2 mb-8 text-neutral-400 hover:text-white transition-colors tracking-widest uppercase text-sm border-b border-transparent hover:border-white pb-1">
      <ArrowLeft class="w-4 h-4" /> กลับไปยังผลิตภัณฑ์
    </a>

    <!-- Hero -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 mb-16">
      <div data-aos="fade-right">
        <span class="font-serif tracking-[0.2em] text-xs uppercase text-neutral-500 mb-4 block">นวัตกรรมและการป้องกัน</span>
        <h1 class="font-serif text-5xl md:text-6xl font-light mb-8 tracking-tight">
          อุปกรณ์เครื่องเป่า <span class="italic text-neutral-400">ลมไม้</span>
        </h1>
        <p class="text-xl font-light text-neutral-300 leading-relaxed mb-10">
          คอลเลกชันอุปกรณ์เครื่องลมของเราถูกพัฒนาโดยยึดจากความเข้าใจต่อความต้องการของผู้เล่น เราเลือกใช้วัสดุคุณภาพและออกแบบอย่างละเอียดเพื่อยกระดับการเล่นของคุณ
        </p>

        <div class="space-y-8">
          <div class="flex gap-6">
            <div class="w-12 h-12 rounded-full bg-white/5 border border-white/10 flex items-center justify-center shrink-0">
              <Zap class="w-5 h-5 text-white opacity-70" />
            </div>
            <div>
              <h3 class="font-serif text-xl text-white mb-2">ปรับปรุงประสิทธิภาพ</h3>
              <p class="text-neutral-400 font-light text-sm">อุปกรณ์แต่ละชิ้นถูกออกแบบมาเพื่อปรับปรุงการตอบสนอง ความสั่นไหว หรือความใช้งานได้</p>
            </div>
          </div>
          <div class="flex gap-6">
            <div class="w-12 h-12 rounded-full bg-white/5 border border-white/10 flex items-center justify-center shrink-0">
              <Shield class="w-5 h-5 text-white opacity-70" />
            </div>
            <div>
              <h3 class="font-serif text-xl text-white mb-2">ดูแลเครื่องดนตรี</h3>
              <p class="text-neutral-400 font-light text-sm">การป้องกันที่เกินกว่าพื้นผิว เพื่อให้เครื่องดนตรีของคุณอยู่ในสภาพที่ดีที่สุด</p>
            </div>
          </div>
        </div>
      </div>

      <div class="relative" data-aos="fade-left">
        <div class="aspect-[4/5] rounded-3xl overflow-hidden border border-white/10 shadow-2xl">
          <img src={hero.heroImage} alt="อุปกรณ์เครื่องเป่าลมไม้" class="w-full h-full object-cover" loading="lazy" />
        </div>
        <div class="absolute -bottom-8 -left-8 bg-neutral-900 border border-white/10 p-8 rounded-3xl shadow-2xl hidden md:block max-w-xs">
          <Sparkles class="w-6 h-6 text-white mb-4 opacity-50" />
          <p class="text-sm font-light text-neutral-300 italic">"อุปกรณ์เสริมที่มีคุณภาพ จะทำให้เส้นทางดนตรีของคุณมั่นคง โปรดติดต่อเราสำหรับรายละเอียดเพิ่มเติม"</p>
        </div>
      </div>
    </div>

    <!-- Accessories gallery — auto-populated from products.ts -->
    <div class="border-t border-white/10 pt-24">
      <h2 class="font-serif text-3xl font-light mb-12 text-center">
        ปัจจุบัน <span class="italic text-neutral-400">ไฮไลท์</span>
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {accessories.map((acc, i) => (
          <a
            href={`/th/product/${acc.slug}`}
            class="group relative overflow-hidden rounded-3xl ikigai-glass"
            data-aos="fade-up"
            data-aos-delay={i * 100}
          >
            <div class="h-80 overflow-hidden relative">
              <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent z-10"></div>
              <img src={acc.thumbnail} alt={acc.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-1000" loading="lazy" />
            </div>
            <div class="absolute bottom-0 left-0 p-8 z-20 w-full">
              <h2 class="font-serif text-2xl text-white mb-2 group-hover:text-glow transition-all">{acc.name}</h2>
              {acc.badge && (
                <span class="inline-block mb-2 border border-white/40 px-3 py-0.5 rounded-full text-xs tracking-widest uppercase text-neutral-100">{acc.badge}</span>
              )}
              <p class="text-neutral-200 font-light text-sm mb-6 opacity-75 translate-y-4 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-500">
                {acc.shortDesc}
              </p>
              <span class="inline-block border border-white/20 px-5 py-2 rounded-full text-xs font-medium tracking-widest uppercase text-white hover:bg-white hover:text-black transition-colors">ดูรายละเอียด</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</Layout>
