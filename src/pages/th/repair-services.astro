            </ul>
            <div class="card-actions justify-end mt-8">
              <a href="/th/booking" class="btn btn-secondary w-full tracking-widest uppercase">ทำการจอง</a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Bassoon Section -->
    <div>
      <div class="mb-12 text-center" data-aos="fade-up">
        <h2 class="font-serif text-4xl font-light mb-4">แบสซูน</h2>
        <p class="text-lg font-light text-neutral-400">เราใช้แชลคที่มีคุณภาพและแพดพิซโซนี่แท้ของเรา</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
        <!-- Standard -->
        <div class="card hover:border-white/40 transition-colors" data-aos="fade-up" data-aos-delay="100">
          <div class="card-body">
            <h3 class="card-title text-2xl">มาตรฐาน</h3>
            <div class="text-white font-medium text-3xl my-4">เริ่มต้น 3,500 THB</div>
            <ul class="space-y-3 mt-4 flex-grow font-light text-neutral-300">
