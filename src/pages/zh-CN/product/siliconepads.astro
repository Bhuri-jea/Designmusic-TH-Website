---
import ProductLayout from '../../../layouts/ProductLayout.astro';
import { CheckCircle2 } from 'lucide-svelte';
import { products } from '../../../lib/products';

const p = products.find(x => x.slug === 'siliconepads')!;
---

<ProductLayout
  title="硅胶垫"
  pageTitle="硅胶垫"
  badge={p.badge}
  heroImage={p.heroImage}
  galleryImages={p.galleryImages}
  backHref="/zh-CN/product"
  backLabel="返回产品"
  lang="zh-CN"
>
  <p class="text-xl font-light text-neutral-400 mb-6">萨克斯 &amp; 单簧管八度键用</p>

  <div class="prose max-w-none text-neutral-300 font-light leading-relaxed">
    <p class="text-lg">
      创新的尖锥形硅胶垫有助于减少八度高音处的气流噪声，使高音更清晰、更易演奏。
    </p>

    <div class="bg-white/5 backdrop-blur-sm rounded-3xl p-8 my-8 space-y-6 border border-white/10">
      <h3 class="font-medium tracking-widest uppercase text-sm flex items-center gap-3 text-white m-0">
        <CheckCircle2 class="w-5 h-5 text-neutral-400" /> 优点
      </h3>
      <ul class="list-none space-y-4 m-0 p-0 text-neutral-400">
        <li class="flex items-start gap-3"><span class="text-white font-bold opacity-50">•</span>减少气流停滞区域</li>
        <li class="flex items-start gap-3"><span class="text-white font-bold opacity-50">•</span>将气流导向两侧</li>
        <li class="flex items-start gap-3"><span class="text-white font-bold opacity-50">•</span>使用寿命长，性能稳定</li>
      </ul>
    </div>
  </div>

  <!-- Reservation notice in the purchase slot -->
  <div slot="purchase" class="p-6 bg-neutral-900 border border-white/10 shadow-2xl rounded-3xl flex flex-col sm:flex-row gap-6 items-start sm:items-center">
    <svg xmlns="http://www.w3.org/2000/svg" class="stroke-white shrink-0 h-6 w-6 opacity-70" fill="none" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
    </svg>
    <div class="flex-grow">
      <h3 class="font-medium tracking-widest uppercase text-white text-sm">仅预约制</h3>
      <div class="text-sm font-light text-neutral-400 mt-2">请直接联系我们了解详情。</div>
    </div>
    <div class="flex-none w-full sm:w-auto mt-4 sm:mt-0">
      <a href="/zh-CN/repair-services" class="inline-block px-8 py-3 bg-white text-black font-medium tracking-widest uppercase rounded-full hover:bg-neutral-200 transition-colors w-full text-center text-sm shadow-[0_0_20px_-5px_rgba(255,255,255,0.3)]">预约</a>
    </div>
  </div>
</ProductLayout>
