---
import Layout from '../../../layouts/Layout.astro';
import { products } from '../../../lib/products';

// All products that belong to this category
const accessories = products.filter(p => p.category === 'woodwindaccessories');
const hero = products.find(p => p.slug === 'woodwindaccessories')!;
---

<Layout title="木管配件">
  <div class="max-w-7xl mx-auto px-6 py-16 relative z-10">
    <a href="/zh-CN/product" class="inline-flex items-center gap-2 mb-8 text-neutral-400 hover:text-white transition-colors tracking-widest uppercase text-sm border-b border-transparent hover:border-white pb-1">
      <svg viewBox="0 0 24 24" aria-hidden="true" class="w-4 h-4"><path d="M15 18l-6-6 6-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
      返回产品
    </a>

    <!-- Hero -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 mb-16">
      <div data-aos="fade-right">
        <span class="font-serif tracking-[0.2em] text-xs uppercase text-neutral-500 mb-4 block">创新与保护</span>
        <h1 class="font-serif text-5xl md:text-6xl font-light mb-8 tracking-tight">
          木管 <span class="italic text-neutral-400">配件</span>
        </h1>
        <p class="text-xl font-light text-neutral-300 leading-relaxed mb-10">
          我们的木管配件系列源自对演奏者需求的深入理解。通过高品质材料与精密设计，我们提供旨在提升演奏表现的解决方案。
        </p>

        <div class="space-y-8">
          <div class="flex gap-6">
            <div class="w-12 h-12 rounded-full bg-white/5 border border-white/10 flex items-center justify-center shrink-0 text-white/70">
              <svg viewBox="0 0 24 24" aria-hidden="true" class="w-5 h-5"><path d="M13 2L4 13h6l-1 9 9-11h-6l1-9z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </div>
            <div>
              <h3 class="font-serif text-xl text-white mb-2">增强演奏性能</h3>
              <p class="text-neutral-400 font-light text-sm">每件配件都设计用于改善响应、共鸣或可演奏性。</p>
            </div>
          </div>
          <div class="flex gap-6">
            <div class="w-12 h-12 rounded-full bg-white/5 border border-white/10 flex items-center justify-center shrink-0 text-white/70">
              <svg viewBox="0 0 24 24" aria-hidden="true" class="w-5 h-5"><path d="M12 3l7 3v6c0 4.5-2.8 8.7-7 11-4.2-2.3-7-6.5-7-11V6l7-3zm-1 6h2v4h-2zm0 5h2v2h-2z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </div>
            <div>
              <h3 class="font-serif text-xl text-white mb-2">乐器护理</h3>
              <p class="text-neutral-400 font-light text-sm">超越表面的保护，确保您的乐器始终处于最佳状态。</p>
            </div>
          </div>
        </div>
      </div>

      <div class="relative" data-aos="fade-left">
        <div class="aspect-[4/5] flex items-center justify-center rounded-md overflow-hidden border border-white/10 bg-neutral-950">
          <img src={hero.heroImage} alt="木管配件" class="w-full h-full object-contain" loading="lazy" />
        </div>
      </div>
    </div>

    <!-- Accessories gallery — auto-populated from products.ts -->
    <div class="border-t border-white/10 pt-24">
      <h2 class="font-serif text-3xl font-light mb-12 text-center">
        当前 <span class="italic text-neutral-400">精选</span>
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {accessories.map((acc, i) => (
          <a
            href={`/zh-CN/product/${acc.slug}`}
            class="card group transition-colors hover:border-white/30"
            data-aos="fade-up"
            data-aos-delay={i * 100}
          >
            <div class="flex h-72 items-center justify-center bg-neutral-900 p-4">
              <img src={acc.thumbnail} alt={acc.name} class="w-full h-full object-contain" loading="lazy" />
            </div>
            <div class="card-body">
              <h2 class="font-serif text-2xl text-white mb-2">{acc.name}</h2>
              {acc.badge && (
                <span class="badge self-start mb-2">{acc.badge}</span>
              )}
              <p class="text-neutral-400 font-light text-sm mb-6">
                {acc.shortDesc}
              </p>
              <span class="mt-auto text-xs font-medium tracking-widest uppercase text-[#c2aa6a]">查看详情</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</Layout>
