              <li class="flex items-center gap-3"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-neutral-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg> 弹簧更换</li>
              <li class="flex items-center gap-3"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-neutral-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg> 毛毡更换</li>
              <li class="flex items-center gap-3"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-neutral-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg> 凹陷修复</li>
            </ul>
            <div class="card-actions justify-end mt-8">
              <a href="/zh-CN/booking" class="btn btn-secondary w-full tracking-widest uppercase">预约</a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Bassoon Section -->
    <div>
      <div class="mb-12 text-center">
        <h2 class="font-serif text-4xl font-light mb-4">大管</h2>
        <p class="text-lg font-light text-neutral-400">我们使用优质虫胶和正品皮佐尼垫。</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
        <!-- Standard -->
        <div class="card hover:border-white/40 transition-colors">
          <div class="card-body">
            <h3 class="card-title text-2xl">标准</h3>
            <div class="text-white font-medium text-3xl my-4">起价 3,500 THB</div>
            <ul class="space-y-3 mt-4 flex-grow font-light text-neutral-300">
              <li class="flex items-center gap-3"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-neutral-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg> 垫片调整</li>
              <li class="flex items-center gap-3"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-neutral-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg> 软木更换</li>
              <li class="flex items-center gap-3"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-neutral-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg> 垫片更换</li>
              <li class="flex items-center gap-3"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-neutral-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg> 机身清洁</li>
              <li class="flex items-center gap-3"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-neutral-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg> 弹簧更换</li>
            </ul>
            <div class="card-actions justify-end mt-8">
              <a href="/zh-CN/booking" class="btn btn-secondary w-full tracking-widest uppercase">预约</a>
            </div>
          </div>
        </div>

