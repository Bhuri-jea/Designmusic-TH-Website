---
import '../../styles/repair-editorial.css';
import Layout from '../../layouts/Layout.astro';
import RepairAvailability from '../../components/ui/RepairAvailability.svelte';
---

<Layout title="维修服务" surface="repair">
  <div class="repair-editorial">
    <section class="repair-hero">
      <img src="/images/soprano%20sax.jpg" alt="" class="repair-hero-image" fetchpriority="high" />
    <div class="repair-hero-content">
      <h1 class="font-serif text-5xl md:text-6xl font-light mb-6 tracking-tight">维修 <span class="italic text-neutral-400">&amp; 服务</span></h1>
      <p class="text-xl font-light text-neutral-400 max-w-3xl mx-auto leading-relaxed">
        凭借在台湾接受的集中维修培训和超过 10 年的实际经验，我们致力于改善每把乐器的音色、响应和特性。
      </p>
      <a href="/zh-CN/booking" class="repair-hero-cta">预约</a>
    </div>
    </section>
    <div class="repair-content">
    <div class="repair-calendar" id="repair-availability"><RepairAvailability lang="zh-CN" client:load /></div>

    <!-- Alert / Notice -->
    <div class="alert shadow-lg max-w-2xl mx-auto mb-16">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-white shrink-0 w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
      <div>
        <h3 class="font-medium tracking-widest uppercase text-sm text-white mb-2">请注意：</h3>
        <ul class="text-sm list-disc list-inside text-neutral-400 space-y-1 font-light">
          <li>这些是仅供参考的估计价格。</li>
          <li>维修费用取决于您的乐器状况。</li>
          <li>请在网站上选择空闲时段预约。如需帮助选择服务，请联系我们。</li>
        </ul>
      </div>
    </div>



    <div class="repair-workshop"><img src="/images/repair1.jpg" alt="维修技师在工作台维修乐器" class="repair-workshop-image" loading="lazy" /></div>
    <!-- Saxophone Section -->
    <div class="mb-32">
      <div class="mb-12 text-center">
        <h2 class="font-serif text-4xl font-light mb-4">萨克斯</h2>
        <p class="text-lg font-light text-neutral-400">我们使用优质虫胶和正品皮佐尼垫。</p>
        <p class="text-lg font-light text-neutral-400">高音、中音、次中音、低音萨克斯都欢迎。</p>
        <p class="text-sm text-neutral-500 mt-4 italic">（以下参考价格适用于中音萨克斯。）</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Basic -->
        <div class="card hover:border-white/40 transition-colors">
          <div class="card-body">
            <h3 class="card-title text-2xl">基础</h3>
            <div class="text-white font-medium text-3xl my-4">起价 1,000 THB</div>
            <ul class="space-y-3 mt-4 flex-grow font-light text-neutral-300">
              <li class="flex items-center gap-3"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-neutral-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg> 垫片调整</li>
              <li class="flex items-center gap-3"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-neutral-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg> 软木更换</li>
            </ul>
            <div class="card-actions justify-end mt-8">
              <a href="/zh-CN/booking" class="btn btn-secondary w-full tracking-widest uppercase">预约</a>
            </div>
          </div>
        </div>

        <!-- Standard -->
        <div class="card bg-white text-black">
          <div class="card-body relative">
            <div class="self-end bg-black text-white px-3 py-1 rounded-full text-xs font-medium tracking-widest uppercase border border-white/20">热门</div>
            <h3 class="card-title text-2xl text-black">标准</h3>
            <div class="font-medium text-3xl my-4">起价 3,500 THB</div>
            <ul class="space-y-3 mt-4 flex-grow font-light">
              <li class="flex items-center gap-3"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-neutral-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg> 垫片调整</li>
              <li class="flex items-center gap-3"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-neutral-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg> 软木更换</li>
              <li class="flex items-center gap-3"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-neutral-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg> 垫片更换</li>
              <li class="flex items-center gap-3"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-neutral-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg> 机身清洁</li>
              <li class="flex items-center gap-3"><svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-neutral-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg> 弹簧更换</li>
            </ul>
            <div class="card-actions justify-end mt-8">
              <a href="/zh-CN/booking" class="btn bg-black text-white hover:bg-neutral-800 w-full tracking-widest uppercase">预约</a>
            </div>
